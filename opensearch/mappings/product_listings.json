{
    "settings": {
        "index.knn": true,
        "knn.algo_param.ef_search": 128,
        "analysis": {
            "filter": {
                "english_stop": {
                    "type": "stop",
                    "stopwords": "_english_"
                },
                "english_stemmer": {
                    "type": "stemmer",
                    "language": "english"
                },
                "english_possessive_stemmer": {
                    "type": "stemmer",
                    "language": "possessive_english"
                },
                "english_synonyms": {
                    "type": "synonym_graph",
                    "synonyms_path": "analysis/english_synonyms.txt",
                    "updateable": true
                },
                "german_stop": {
                    "type": "stop",
                    "stopwords": "_german_"
                },
                "german_stemmer": {
                    "type": "stemmer",
                    "language": "light_german"
                },
                "german_synonyms": {
                    "type": "synonym_graph",
                    "synonyms_path": "analysis/german_synonyms.txt",
                    "updateable": true
                },
                "french_stop": {
                    "type": "stop",
                    "stopwords": "_french_"
                },
                "french_stemmer": {
                    "type": "stemmer",
                    "language": "light_french"
                },
                "french_elision": {
                    "type": "elision",
                    "articles_case": true,
                    "articles": [
                        "l",
                        "m",
                        "t",
                        "qu",
                        "n",
                        "s",
                        "j",
                        "d",
                        "c",
                        "jusqu",
                        "quoiqu",
                        "lorsqu",
                        "puisqu"
                    ]
                },
                "french_synonyms": {
                    "type": "synonym_graph",
                    "synonyms_path": "analysis/french_synonyms.txt",
                    "updateable": true
                },
                "spanish_stop": {
                    "type": "stop",
                    "stopwords": "_spanish_"
                },
                "spanish_stemmer": {
                    "type": "stemmer",
                    "language": "light_spanish"
                },
                "spanish_synonyms": {
                    "type": "synonym_graph",
                    "synonyms_path": "analysis/spanish_synonyms.txt",
                    "updateable": true
                },
                "italian_stop": {
                    "type": "stop",
                    "stopwords": "_italian_"
                },
                "italian_stemmer": {
                    "type": "stemmer",
                    "language": "light_italian"
                },
                "italian_synonyms": {
                    "type": "synonym_graph",
                    "synonyms_path": "analysis/italian_synonyms.txt",
                    "updateable": true
                }
            },
            "analyzer": {
                "english_with_synonyms": {
                    "type": "custom",
                    "tokenizer": "standard",
                    "filter": [
                        "english_possessive_stemmer",
                        "lowercase",
                        "english_synonyms",
                        "english_stop",
                        "english_stemmer"
                    ]
                },
                "german_with_synonyms": {
                    "type": "custom",
                    "tokenizer": "standard",
                    "filter": [
                        "lowercase",
                        "german_stop",
                        "german_synonyms",
                        "german_normalization",
                        "german_stemmer"
                    ]
                },
                "french_with_synonyms": {
                    "type": "custom",
                    "tokenizer": "standard",
                    "filter": [
                        "french_elision",
                        "lowercase",
                        "french_synonyms",
                        "french_stop",
                        "french_stemmer"
                    ]
                },
                "spanish_with_synonyms": {
                    "type": "custom",
                    "tokenizer": "standard",
                    "filter": [
                        "lowercase",
                        "spanish_synonyms",
                        "spanish_stop",
                        "spanish_stemmer"
                    ]
                },
                "italian_with_synonyms": {
                    "type": "custom",
                    "tokenizer": "standard",
                    "filter": [
                        "lowercase",
                        "italian_synonyms",
                        "italian_stop",
                        "italian_stemmer"
                    ]
                }
            }
        }
    },
    "mappings": {
        "properties": {
            "projectionDeleted": {"type": "boolean"},
            "productListingId": {
                "type": "keyword"
            },
            "productListingTitleSlugId": {
                "type": "keyword"
            },
            "listingSourceId": {
                "type": "keyword"
            },
            "sourceListingId": {
                "type": "keyword"
            },

            "eventId": {
                "type": "keyword"
            },
            "auctionId": {
                "type": "keyword"
            },
            "hasAuctionContext": {
                "type": "boolean"
            },
            "title": {
                "type": "object",
                "properties": {
                    "text": {
                        "type": "text"
                    },
                    "language": {
                        "type": "keyword"
                    }
                }
            },
            "titleDe": {
                "type": "text",
                "analyzer": "german",
                "search_analyzer": "german_with_synonyms"
            },
            "titleEn": {
                "type": "text",
                "analyzer": "english",
                "search_analyzer": "english_with_synonyms"
            },
            "titleFr": {
                "type": "text",
                "analyzer": "french",
                "search_analyzer": "french_with_synonyms"
            },
            "titleEs": {
                "type": "text",
                "analyzer": "spanish",
                "search_analyzer": "spanish_with_synonyms"
            },
            "titleIt": {
                "type": "text",
                "analyzer": "italian",
                "search_analyzer": "italian_with_synonyms"
            },
            "sourcePrice": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "keyword"
                    },
                    "amount": {
                        "type": "unsigned_long"
                    },
                    "currency": {
                        "type": "keyword"
                    }
                }
            },
            "salePrices": {
                "type": "object",
                "properties": {
                    "eur": { "type": "unsigned_long" },
                    "gbp": { "type": "unsigned_long" },
                    "usd": { "type": "unsigned_long" },
                    "aud": { "type": "unsigned_long" },
                    "cad": { "type": "unsigned_long" },
                    "nzd": { "type": "unsigned_long" },
                    "cny": { "type": "unsigned_long" },
                    "brl": { "type": "unsigned_long" },
                    "pln": { "type": "unsigned_long" },
                    "try": { "type": "unsigned_long" },
                    "jpy": { "type": "unsigned_long" },
                    "czk": { "type": "unsigned_long" },
                    "rub": { "type": "unsigned_long" },
                    "aed": { "type": "unsigned_long" },
                    "sar": { "type": "unsigned_long" },
                    "hkd": { "type": "unsigned_long" },
                    "sgd": { "type": "unsigned_long" },
                    "chf": { "type": "unsigned_long" },
                    "zar": { "type": "unsigned_long" }
                }
            },
            "saleObservationFxRateId": {
                "type": "keyword"
            },
            "saleObservedAt": {
                "type": "date",
                "format": "strict_date_time"
            },
            "availability": {
                "type": "keyword"
            },
            "url": {
                "type": "keyword"
            },
            "images": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "keyword"
                    }
                }
            },
            "embedding": {
                "type": "knn_vector",
                "dimension": 768,
                "method": {
                    "engine": "faiss",
                    "space_type": "cosinesimil",
                    "name": "hnsw",
                    "parameters": {
                        "m": 32,
                        "ef_construction": 512,
                        "encoder": {
                            "name": "sq",
                            "parameters": {
                                "type": "fp16",
                                "clip": false
                            }
                        }
                    }
                }
            },
            "lotLabel": {
                "type": "keyword"
            },
            "lotPosition": {
                "type": "unsigned_long"
            },
            "lotBiddingOpensAt": {
                "type": "date",
                "format": "strict_date_time"
            },
            "lotScheduledClosesAt": {
                "type": "date",
                "format": "strict_date_time"
            },
            "lotReportedClosedAt": {
                "type": "date",
                "format": "strict_date_time"
            },
            "created": {
                "type": "date",
                "format": "strict_date_time"
            },
            "updated": {
                "type": "date",
                "format": "strict_date_time"
            },
            "createdBy": {
                "type": "keyword"
            },
            "updatedBy": {
                "type": "keyword"
            }
        },
        "dynamic": "strict"
    }
}
