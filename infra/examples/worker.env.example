# Example only. Replace the example account/URL with the data-stack outputs.
# AWS_REGION = WorkerQueueAwsRegion; STAGE = WorkerQueueStage.
AWS_REGION=eu-central-1
STAGE=prod
AURA_HISTORIA_WORKER_SCOPE=notification-delivery
# WorkerNotificationDeliveryQueueUrl (never the DLQ URL).
AURA_HISTORIA_WORKER_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/123456789012/aura-worker-notification-delivery-prod

# Keep the existing AWS SDK credential chain. No new access keys.
# The externally owned role needs this scope's PublisherPolicyArn and ConsumerPolicyArn
# when the same worker process both accepts CDC and polls SQS.
# Keep existing POSTGRES_* and scope-specific settings.
# EMAIL delivery still needs existing S3 read / SES send grants and settings:
# S3_BUCKET_NAME_TEMPLATES, NOTIFICATION_EMAIL_FROM, NOTIFICATION_EMAIL_REPLY_TO,
# COMMIT_SHA, and STAGE. These queue policies do not replace those grants.
# Do not set AWS_ENDPOINT_URL or AWS_ENDPOINT_URL_SQS for real AWS stages.
