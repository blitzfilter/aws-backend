  "$defs": {
    "__schema0": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "__schema1": {
      "type": "string",
      "enum": [
        "dev",
        "prod",
        "ephemeral",
        "local",
        "test"
      ]
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "cpu_millicores": {
          "$ref": "#/$defs/__schema3"
        },
        "memory_mib": {
          "$ref": "#/$defs/__schema3"
        },
        "disk_mib": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "cpu_millicores",
        "memory_mib",
        "disk_mib"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema4": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "SECRETS_MANAGER",
            "SSM_SECURE",
            "PROTECTED_FILE"
          ]
        },
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "revision": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "provider",
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "description": "Business ingress and separate HTTP operational listener. Probe through an allowlisted slot-local execution, never publish/proxy operations. Ports conservatively reserve host-wide capacity, including shared network namespaces.",
      "type": "object",
      "properties": {
        "listener": {
          "$ref": "#/$defs/__schema7"
        },
        "endpoint": {
          "$ref": "#/$defs/__schema9"
        },
        "operations_listener": {
          "type": "object",
          "properties": {
            "port": {
              "$ref": "#/$defs/__schema8"
            },
            "bind": {
              "type": "string",
              "const": "LOOPBACK"
            }
          },
          "required": [
            "port",
            "bind"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "listener",
        "endpoint",
        "operations_listener"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "description": "TCP reservation. One host port belongs to one listener, even across bind addresses.",
      "type": "object",
      "properties": {
        "port": {
          "$ref": "#/$defs/__schema8"
        },
        "bind": {
          "type": "string",
          "enum": [
            "LOOPBACK",
            "PRIVATE",
            "PUBLIC",
            "ALL_IPV4",
            "ALL_IPV6",
            "ALL_INTERFACES"
          ]
        }
      },
      "required": [
        "port",
        "bind"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 65535
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "host": {
          "$ref": "#/$defs/__schema4"
        },
        "port": {
          "$ref": "#/$defs/__schema8"
        },
        "tls": {
          "$ref": "#/$defs/__schema10"
        },
        "routing": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "PRIVATE_NETWORK",
                "WIREGUARD",
                "LOCAL_TEST"
              ]
            },
            "target_host_id": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "method",
            "target_host_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "host",
        "port",
        "tls",
        "routing"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "VERIFY_FULL"
            },
            "server_name": {
              "$ref": "#/$defs/__schema4"
            },
            "ca_ref": {
              "$ref": "#/$defs/__schema5"
            }
          },
          "required": [
            "mode",
            "server_name",
            "ca_ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "DISABLED"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/__schema12"
        },
        "pool_max": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "identity",
        "pool_max"
      ],
      "additionalProperties": false
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "principal": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "secret_ref": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "principal",
        "secret_ref"
      ],
      "additionalProperties": false
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "ROLES_ANYWHERE"
        },
        "stage": {
          "$ref": "#/$defs/__schema1"
        },
        "application_identity_ref": {
          "$ref": "#/$defs/__schema5"
        },
        "trust_anchor_ref": {
          "$ref": "#/$defs/__schema5"
        },
        "profile_ref": {
          "$ref": "#/$defs/__schema5"
        },
        "certificate_ref": {
          "$ref": "#/$defs/__schema5"
