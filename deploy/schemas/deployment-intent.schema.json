{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Exact operation authorization claim, not proof of approval. assertIntentBinding requires independent trusted context and a canonical plan hasher. Protected approval-store identity, provenance verification and atomic nonce/revision enforcement remain mandatory outside this pure module.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "DEPLOYMENT_INTENT"
    },
    "example": {
      "type": "boolean"
    },
    "target": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "dev",
            "prod",
            "ephemeral",
            "local",
            "test"
          ]
        },
        "account": {
          "type": "string",
          "pattern": "^[0-9]{12}$"
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z]{2}(?:-gov)?-[a-z]+-[1-9][0-9]?$"
        }
      },
      "required": [
        "stage",
        "account",
        "region"
      ],
      "additionalProperties": false
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "expected_environment_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "current_manifest_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "inventory_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "infrastructure_context_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "operation_class": {
      "type": "string",
      "enum": [
        "STANDARD",
        "MAINTENANCE",
        "REPAIR_FORWARD",
        "ROLLBACK"
      ]
    },
    "operation_id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "controller": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\/[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "workflow": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^\\.github\\/workflows\\/[a-zA-Z0-9_-]+\\.ya?ml$"
        },
        "run_id": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "run_attempt": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "repository",
        "workflow",
        "run_id",
        "run_attempt",
        "source_sha",
        "sha256"
      ],
      "additionalProperties": false
    },
    "helper": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\/[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "workflow": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^\\.github\\/workflows\\/[a-zA-Z0-9_-]+\\.ya?ml$"
        },
        "run_id": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "run_attempt": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "repository",
        "workflow",
        "run_id",
        "run_attempt",
        "source_sha",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "example",
    "target",
    "manifest_sha256",
    "source_sha",
    "expected_environment_revision",
    "current_manifest_sha256",
    "inventory_sha256",
    "configuration_sha256",
    "infrastructure_context_sha256",
    "operation_class",
    "operation_id",
    "nonce",
    "plan_sha256",
    "controller",
    "helper"
  ],
  "additionalProperties": false
}
